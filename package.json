{
  "name": "ros2-quick-runner",
  "displayName": "ros2-quick-runner",
  "description": "Quickly run ROS 2 launch, Python, and C++ files",
  "icon": "icon/ros2-quick-runner.ico",
  "version": "0.0.5",
  "publisher": "knighthood2001",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Knighthood2001/vscode-ros2-quick-runner.git"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [{
      "command": "ros2-quick-runner.getWorkspaceName",
      "title": "ros2 source"
    }, {
      "command": "ros2-quick-runner.ros2launch",
      "title": "ros2 launch"
    }, {
      "command": "ros2-quick-runner.ros2run",
      "title": "ros2 run"
    }, {
      "command": "ros2-quick-runner.colconBuild",
      "title": "colcon build"
    }],
    "menus": {
      "explorer/context": [
        {
          "command": "ros2-quick-runner.getWorkspaceName",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@2"
        },
        {
          "command": "ros2-quick-runner.ros2launch",
          "when": "resourceFilename =~ /\\.launch\\.py$/",
          "group": "navigation@1"
        },
        {
          "command": "ros2-quick-runner.ros2run",
          "when": "resourceExtname == .cpp || (resourceExtname == .py && !(resourceFilename =~ /\\.launch\\.py$/))",
          "group": "navigation@1"
        },
        {
          "command": "ros2-quick-runner.colconBuild",
          "when": "explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.16.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
